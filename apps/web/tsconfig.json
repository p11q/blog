{
  "extends": "@repo/typescript-config/config.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "ES2022",
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
